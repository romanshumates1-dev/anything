{
  "workspaces": [
    "apps/*"
  ],
  "resolutions": {
    "react-native": "patch:react-native@npm%3A0.81.4#~/.yarn/patches/react-native+0.81.4.patch",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-screens": "4.16.0"
  },
  "scripts": {
    "build": "yarn workspace web build",
    "dev": "yarn workspace web dev",
    "dev:clean": "node scripts/dev-clean.mjs && yarn workspace web dev",
    "jobs:dev": "yarn workspace web jobs:dev",
    "test": "yarn workspace web test",
    "test:watch": "yarn workspace web test:watch",
    "lint": "yarn oxlint && yarn tsc --noEmit",
    "lint:fix": "yarn oxlint --fix && yarn oxfmt --write .",
    "format": "yarn oxfmt --write .",
    "format:check": "yarn oxfmt --check .",
    "clean": "echo 'No clean configured for root workspace yet.'",
    "typecheck": "yarn workspace web typecheck",
    "desktop:dev": "yarn workspace desktop dev",
    "desktop:build": "yarn workspace desktop build",
    "desktop:typecheck": "yarn workspace desktop typecheck",
    "desktop:dist": "yarn workspace desktop dist",
    "desktop:dist:win": "yarn workspace desktop dist:win",
    "desktop:dist:mac": "yarn workspace desktop dist:mac",
    "desktop:dist:linux": "yarn workspace desktop dist:linux"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "eslint": "^9.27.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript-eslint": "^8.33.0"
  },
  "packageManager": "yarn@4.12.0"
}
