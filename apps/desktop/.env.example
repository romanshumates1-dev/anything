# DealFlow AI Desktop — environment overrides (all optional).
# Copy to `.env` for local use, or set these in the launch environment.
# The desktop app is a thin, hardened shell around the hosted SaaS, so it needs
# no secrets — only which URL to load and which origins to trust.

# Base URL of the DealFlow AI web app the shell loads.
#   - Dev default:  http://localhost:4000  (matches `yarn dev` for the web app)
#   - Prod default: https://app.dealflow.ai
# This is also editable at runtime in Settings; the env var only sets the
# initial/default value.
DEALFLOW_APP_URL=http://localhost:4000

# Comma-separated extra origins allowed for in-window navigation (everything
# else opens in the user's real browser). Add auth providers or a CDN here.
# Example: https://accounts.google.com,https://cdn.dealflow.ai
DEALFLOW_ALLOWED_ORIGINS=
