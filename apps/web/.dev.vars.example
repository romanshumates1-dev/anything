# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Workers — LOCAL development secrets (copy to `.dev.vars`)
#
#   cp .dev.vars.example .dev.vars      # then fill in real values
#
# `.dev.vars` is gitignored (see .gitignore). It is read by:
#   - `yarn cf:preview`  (opennextjs-cloudflare preview → local workerd runtime)
#   - `wrangler dev`
#
# For the DEPLOYED worker these same names go up as Cloudflare secrets:
#   wrangler secret bulk .dev.vars        # or `wrangler secret put NAME` per key
#
# LIMIT (Workers Free): 64 environment variables per Worker, 5 KB each.
# The app's live apps/web/.env has 32 keys — comfortable headroom. Do NOT
# paste the whole .env.example (136 keys) up; most are optional/mock defaults.
#
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
# They must be present in the build environment (see .github/workflows), not
# just as Worker secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Hard required (instrumentation.ts fails fast without these on Node) ──
DATABASE_URL=
BETTER_AUTH_SECRET=

# ── Canonical app URL — the app serves the APEX and www (301 to apex) ──
# The WordPress site is being retired; Workers serves the apex directly.
# www must 301-redirect to the apex (Cloudflare Redirect Rule) —
# csrfProtection.ts compares hosts, so www POSTs would otherwise be rejected.
BETTER_AUTH_URL=https://dealswiftautomation.com

# ── Access control (domain lock + RBAC) ──
ALLOWED_EMAIL_DOMAINS=dealswiftautomation.com
SEED_ADMIN_EMAILS=roman.shumate@dealswiftautomation.com
MIN_ACCESS_ROLE=ADMIN

# Platform-wide (cross-tenant) administration allowlist.
#
# An account listed here AND holding role=ADMIN in the database may fall back to
# the `org_default` tenant when it has no organization membership of its own.
# Anything else - including any other role=ADMIN account - is refused (403).
#
# This is deliberately NOT implied by role=ADMIN: 16 accounts on the live
# database held that role with no organization, and the role check alone let
# them reach the platform tenant (370k+ leads). Requiring both conditions means
# demoting an account here actually revokes the cross-tenant fallback.
#
# Leave EMPTY to grant nobody the fallback - that is the safe default.
PLATFORM_ADMIN_EMAILS=roman.shumate@dealswiftautomation.com

# ── Cron / job runner auth ──
# CRON_SECRET is what the Cloudflare Cron Trigger (see custom-worker.ts) sends
# as `Authorization: Bearer <CRON_SECRET>` to /api/jobs/process and
# /api/pipeline/cron. JOB_RUNNER_SECRET is the x-job-runner-secret alternative
# used by scripts/jobs-dev.mjs and the Docker worker.
CRON_SECRET=
JOB_RUNNER_SECRET=

# ── AI ──
# Ollama CANNOT run on Workers (it needs localhost TCP and a GPU-class box).
# Use a hosted provider: anthropic | bedrock. NOTE: this file intentionally
# sets anthropic, NOT ollama — ai-settings.ts defaults to anthropic on
# workerd, but an explicit value here documents the choice AND protects
# against a localhost default leaking in from a copied .env.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Only if you front a self-hosted model through a public HTTPS tunnel:
# OLLAMA_BASE_URL=https://ollama.dealswiftautomation.com
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=

# ── Email ──
# SMTP is NOT viable on Workers (outbound port 25/587 is blocked at the
# platform level). EMAIL_PROVIDER=ses on Workers routes to the SES HTTPS API
# (SigV4-signed POST — see ses-sign.ts), NOT to SMTP. Do NOT set gmail/smtp/
# gemini here: selectBestProvider() will refuse them on workerd and fall back
# to mock (logged, never silently dropped).
EMAIL_PROVIDER=ses
EMAIL_FROM_ADDRESS=noreply@dealswiftautomation.com
EMAIL_FROM_NAME=Deal Swift Automation
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_ENABLED=true
# Optional overrides — default to the AWS_* values above when blank:
# AWS_SES_REGION=
# AWS_SES_ACCESS_KEY=
# AWS_SES_SECRET_KEY=
# AWS_SES_FROM_ADDRESS=

# ── SMS (leave DISABLED until 10DLC / toll-free verification clears) ──
AWS_SNS_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_NUMBER_TYPE=
SMS_INBOUND_SECRET=
# Apex domain — update this, or Twilio status callbacks 404.
PUBLIC_WEBHOOK_URL=https://dealswiftautomation.com/api/sms/inbound

# ── Legal / compliance (required for CAN-SPAM footers and contracts) ──
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_STATE=
SUPPORT_EMAIL=

# ── Apollo.io lead source (optional) ──
# Server-side ONLY — never exposed to the client. Set the key as a Worker
# secret: wrangler secret put APOLLO_API_KEY
# Without it, POST /api/lead-finder/apollo returns a precise
# 503 APOLLO_NOT_CONFIGURED (the integration never fakes success).
APOLLO_API_KEY=
# APOLLO_BASE_URL=https://api.apollo.io
# APOLLO_SEARCH_PATH=/api/v1/mixed_people/search
# APOLLO_TIMEOUT_MS=15000

# ── Public seller portal link signing ──
# HMAC key for signed /api/portal/offer links (openssl rand -base64 32).
# Unset = portal links cannot be minted/verified; the portal then requires a
# signed-in session. Fail closed either way.
PORTAL_TOKEN_SECRET=

# ── Synthetic data gates (DEV ONLY — the gate also requires NODE_ENV≠production) ──
ALLOW_SIMULATED_COMPS=false
ALLOW_SIMULATED_LEADS=false

