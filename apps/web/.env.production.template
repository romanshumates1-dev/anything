# ─────────────────────────────────────────────────────────────────────────────
# DealFlow AI — PRODUCTION env template (dealswiftautomation.com)
#
# Set these in Vercel → Project "anything-web" → Settings → Environment Variables
# (Production scope). This file has NO real values — it is a checklist only.
# NEVER commit real secrets; apps/web/.env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──
DATABASE_URL=                 # SECRET — Neon prod branch postgres:// URL
BETTER_AUTH_SECRET=           # SECRET — random 32+ bytes (openssl rand -base64 32)
BETTER_AUTH_URL=https://dealswiftautomation.com
NEXT_PUBLIC_APP_URL=https://dealswiftautomation.com

# ── Access control (domain lock + RBAC) ──
ALLOWED_EMAIL_DOMAINS=dealswiftautomation.com
MIN_ACCESS_ROLE=ADMIN
SEED_ADMIN_EMAILS=roman.shumate@dealswiftautomation.com

# ── AI (Anthropic — the only AI vendor) ──
ANTHROPIC_API_KEY=            # SECRET — needs account credit (else calls 400)
ANTHROPIC_MODEL=claude-sonnet-5
# Optional local/self-hosted model gateway (Ollama). When set, the app can use a
# local OpenAI/Anthropic-compatible endpoint instead of the hosted API.
# AI_PROVIDER=anthropic        # anthropic | ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ── SMS (Twilio) — DO NOT enable live sending until 10DLC is approved ──
TWILIO_ACCOUNT_SID=           # SECRET
TWILIO_AUTH_TOKEN=            # SECRET
TWILIO_MESSAGING_SERVICE_SID= # or TWILIO_FROM_NUMBER
TWILIO_FROM_NUMBER=           # prod sending number (E.164)
TWILIO_NUMBER_TYPE=
TWILIO_10DLC_ASSIGNED_MPS=
TWILIO_10DLC_TMOBILE_DAILY_CAP=
OWNER_NUMBER=                 # owner phone, E.164
PUBLIC_WEBHOOK_URL=https://dealswiftautomation.com/api/sms/inbound
SMS_INBOUND_SECRET=           # SECRET — simulator branch of inbound webhook

# ── Job runner / cron ──
JOB_RUNNER_SECRET=            # SECRET — x-job-runner-secret header (dev poller/docker)
CRON_SECRET=                  # SECRET — Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"

# ── Business config ──
ASSIGNMENT_FEE_CENTS=1000000  # assumed wholesale fee for margin estimates ($10k)
