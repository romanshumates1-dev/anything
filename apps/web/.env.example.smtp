# SMTP Configuration for Live Testing

# Option 1: Gmail (easiest for testing)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password  # Generate at https://myaccount.google.com/apppasswords
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_NAME=Your Name

# Option 2: SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-api-key
# EMAIL_FROM_ADDRESS=verified@yourdomain.com

# Option 3: Mailgun
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=your-api-key
# MAILGUN_DOMAIN=mg.yourdomain.com
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Required for CAN-SPAM
COMPANY_POSTAL_ADDRESS=123 Main St, City, ST 12345
