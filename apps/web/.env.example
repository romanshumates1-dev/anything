# DealFlow AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is in .gitignore.

# =============================================================================
# CORE — Required for basic operation
# =============================================================================
# Neon Postgres connection string (serverless HTTP/WS driver)
DATABASE_URL=

# Session signing secret (32+ random bytes)
BETTER_AUTH_SECRET=

# Auth base URL (where the app is reachable)
BETTER_AUTH_URL=http://localhost:4000

# =============================================================================
# ACCESS CONTROL (RBAC / domain lock)
# =============================================================================
# Comma-separated list of allowed email domains (e.g., yourcompany.com)
ALLOWED_EMAIL_DOMAINS=

# Minimum role required for app access (ADMIN opens everything up)
MIN_ACCESS_ROLE=ADMIN

# Admin emails (seeded as ADMIN on first login)
SEED_ADMIN_EMAILS=

# =============================================================================
# AI PROVIDER — Choose one backend
# =============================================================================
# Anthropic (default) — best quality for production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (local/self-hosted) — free for development
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

# =============================================================================
# SMS PROVIDER — Choose AWS SNS (cheaper) or Twilio
# =============================================================================
# AWS SNS (recommended — ~$0.00645/SMS vs Twilio $0.0079+)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_SMS_ENABLED=true
AWS_SNS_VERIFY_SIGNATURES=true

# Twilio (alternative — leave blank to use AWS SNS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_NUMBER_TYPE=10dlc
OWNER_NUMBER=

# Public webhook URL for signature validation (Twilio or SNS)
PUBLIC_WEBHOOK_URL=

# SMS inbound webhook shared secret (for simulator/testing)
SMS_INBOUND_SECRET=

# =============================================================================
# JOBS / CRON — Background processing
# =============================================================================
# Secret for the job drain endpoint (runs every 3s in dev, cron in prod)
JOB_RUNNER_SECRET=

# Cron secret for scheduled endpoints
CRON_SECRET=

# Override for job poll interval (ms) — used in containers
JOB_POLL_INTERVAL_MS=3000

# =============================================================================
# 10DLC THROUGHPUT
# =============================================================================
TWILIO_10DLC_ASSIGNED_MPS=
TWILIO_10DLC_TMOBILE_DAILY_CAP=

# =============================================================================
# BUSINESS CONFIG
# =============================================================================
# Assumed wholesale fee for margin estimates (default $10k = 1000000 cents)
ASSIGNMENT_FEE_CENTS=1000000

# =============================================================================
# LEGAL ENTITY — substituted into /legal/* docs and the marketing footer
# =============================================================================
# TODO(owner): fill in your actual registered legal entity before launch.
# Unset LEGAL_ENTITY_NAME hides the footer line (no placeholder leaks) but
# leaves [LEGAL_ENTITY_NAME]-style tokens visible on /legal/* pages.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_STATE=
SUPPORT_EMAIL=

# =============================================================================
# OPTIONAL — Leave unset unless used
# =============================================================================
# Google / Apple social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Live flow runner toggle (for CI verification)
RUN_LIVE_FLOWS=

# Test phone verification
TEST_DATABASE_URL=
# ── Phase T: Twilio demo driver (allowlist-only; flag `twilioDemo` must also be ON) ──
# Twilio TEST credentials (magic numbers, no real delivery) or the trial number.
# Demo mode delivers ONLY to verified numbers in test_phone_numbers — cold lists
# are physically excluded at dispatchGate.
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
# Toll-free driver stub (the legit higher-throughput path; see DEPLOY.md):
TOLL_FREE_NUMBER=
TOLL_FREE_VERIFICATION_STATUS=unverified

# ── Phase V-R: inspection clock ──
# Calendar-day counting happens in this IANA zone (default America/New_York).
OWNER_TIMEZONE=America/New_York

# ── CI/test ONLY — never set in prod ──
# Skips ONLY the quiet-hours/send-window gates so pipeline flows are
# wall-clock-independent. DNC/flag/consent/demo/numeric-guard still apply.
# DISPATCH_SKIP_QUIET_HOURS=1
