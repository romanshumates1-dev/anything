# DealFlow AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is in .gitignore.

# =============================================================================
# CORE — Required for basic operation
# =============================================================================
# Neon Postgres connection string (serverless HTTP/WS driver)
DATABASE_URL=

# Session signing secret (32+ random bytes)
BETTER_AUTH_SECRET=

# Auth base URL (where the app is reachable)
BETTER_AUTH_URL=http://localhost:4000

# =============================================================================
# ACCESS CONTROL (RBAC / domain lock)
# =============================================================================
# Comma-separated list of allowed email domains (e.g., yourcompany.com)
ALLOWED_EMAIL_DOMAINS=

# Minimum role required for app access (ADMIN opens everything up)
MIN_ACCESS_ROLE=ADMIN

# Admin emails (seeded as ADMIN on first login)
SEED_ADMIN_EMAILS=

# =============================================================================
# AI PROVIDER — Choose one backend
# =============================================================================
# Anthropic (default) — best quality for production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (local/self-hosted) — free for development
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

# =============================================================================
# SMS (Twilio) — Required for real SMS sends
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_NUMBER_TYPE=10dlc
OWNER_NUMBER=

# Public webhook URL for Twilio signature validation
PUBLIC_WEBHOOK_URL=

# SMS inbound webhook shared secret
SMS_INBOUND_SECRET=

# =============================================================================
# JOBS / CRON — Background processing
# =============================================================================
# Secret for the job drain endpoint (runs every 3s in dev, cron in prod)
JOB_RUNNER_SECRET=

# Cron secret for scheduled endpoints
CRON_SECRET=

# Override for job poll interval (ms) — used in containers
JOB_POLL_INTERVAL_MS=3000

# =============================================================================
# 10DLC THROUGHPUT
# =============================================================================
TWILIO_10DLC_ASSIGNED_MPS=
TWILIO_10DLC_TMOBILE_DAILY_CAP=

# =============================================================================
# BUSINESS CONFIG
# =============================================================================
# Assumed wholesale fee for margin estimates (default $10k = 1000000 cents)
ASSIGNMENT_FEE_CENTS=1000000

# =============================================================================
# BILLING (Stripe) — subscription paywall. Going live is a credentials change,
# not a code change: the same code path runs with test keys (sk_test_) or live
# keys (sk_live_). With test keys + test price ids, checkout is zero-cost.
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids for the self-serve tiers (create these in the Stripe product
# catalog; enterprise is contact-sales and has no price id).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
# Optional — pin the Stripe API version (defaults to the account default).
STRIPE_API_VERSION=

# All-in Twilio cost per SMS segment in CENTS (Twilio msg fee + carrier pass-
# through). Drives the derived per-tier SMS allowance so the plan caps out
# before the funded Twilio budget is exhausted. Default 1.1 if unset.
TWILIO_COST_PER_SEGMENT_CENTS=1.1

# =============================================================================
# LEGAL ENTITY (rendered into legal/policy pages; replace before launch)
# =============================================================================
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_STATE=
SUPPORT_EMAIL=

# =============================================================================
# OPTIONAL — Leave unset unless used
# =============================================================================
# Google / Apple social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Live flow runner toggle (for CI verification)
RUN_LIVE_FLOWS=

# Test phone verification
TEST_DATABASE_URL=