# =============================================================================
# DealFlow AI Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the real .env file - it is in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION (Required)
# -----------------------------------------------------------------------------
# Session signing secret (32+ random bytes)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters

# Auth base URL (where the app is reachable)
BETTER_AUTH_URL=http://localhost:3000

# Access Control (Optional)
ALLOWED_EMAIL_DOMAINS=yourcompany.com                  # Comma-separated list of allowed email domains
SEED_ADMIN_EMAILS=admin@yourcompany.com                # Emails auto-granted admin role on first login
MIN_ACCESS_ROLE=ADMIN                                  # Minimum role required for app access

# OAuth Providers (Optional - enable social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Development (Optional)
LOCAL_DEV_SECRET=                                       # Secret for local development bypasses

# -----------------------------------------------------------------------------
# STRIPE PAYMENTS (Required for Production)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PROVIDER=mock                                   # Options: mock, live (Default: mock)

# -----------------------------------------------------------------------------
# AWS CORE (Required for AWS Services)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1                                   # Default: us-east-1
AWS_SESSION_TOKEN=                                     # Optional - For temporary credentials

# -----------------------------------------------------------------------------
# AWS SES (Email)
# -----------------------------------------------------------------------------
AWS_SES_REGION=                                        # Optional - Defaults to AWS_REGION
AWS_SES_ACCESS_KEY=                                    # Optional - Defaults to AWS_ACCESS_KEY_ID
AWS_SES_SECRET_KEY=                                    # Optional - Defaults to AWS_SECRET_ACCESS_KEY
AWS_SES_SMTP_HOST=                                     # Optional - For SMTP transport
AWS_SES_FROM_ADDRESS=                                  # Optional - Default from address

# -----------------------------------------------------------------------------
# AWS SNS (SMS)
# -----------------------------------------------------------------------------
AWS_SNS_SMS_ENABLED=false                              # Default: false - Enable AWS SNS for SMS
AWS_SNS_VERIFY_SIGNATURES=true                         # Default: true - Verify SNS webhook signatures

# -----------------------------------------------------------------------------
# AWS RCS / PINPOINT (Optional)
# -----------------------------------------------------------------------------
AWS_PINPOINT_APP_ID=                                   # For RCS messaging
AWS_RCS_AGENT_ID=                                      # For RCS messaging

# -----------------------------------------------------------------------------
# TWILIO (SMS/Voice)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=                          # Optional - For messaging service
TWILIO_FROM_NUMBER=                                    # Optional - Default outbound number
TWILIO_PHONE_NUMBER=                                   # Optional - Alternative to TWILIO_FROM_NUMBER
TWILIO_VOICE_FROM_NUMBER=                              # Optional - For voice calls
TWILIO_NUMBER_TYPE=10dlc                               # Optional - Number type (local, toll-free, 10dlc)
OWNER_NUMBER=                                          # Optional - Fallback/owner phone number

# Twilio 10DLC (A2P SMS Compliance)
TWILIO_10DLC_ASSIGNED_MPS=                             # Optional - Messages per second cap
TWILIO_10DLC_TMOBILE_DAILY_CAP=                        # Optional - T-Mobile daily message cap

# Twilio Test Credentials (Optional - for demo/testing)
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
TOLL_FREE_NUMBER=
TOLL_FREE_VERIFICATION_STATUS=unverified

# -----------------------------------------------------------------------------
# SMS CONFIGURATION
# -----------------------------------------------------------------------------
SMS_PROVIDER_URL=                                      # Optional - Custom SMS provider URL
SMS_INBOUND_SECRET=                                    # Required for SMS webhooks
SMS_SENDER_ID=                                         # Optional - Sender ID for SMS

# SMS Rate Limiting (Optional)
A2P_MPS_CAP=                                           # A2P messages per second cap
TMOBILE_DAILY_CAP=                                     # T-Mobile daily cap
OPT_OUT_PAUSE_PCT=                                     # Pause threshold for opt-outs
DELIVERY_PAUSE_PCT=                                    # Pause threshold for delivery failures

# -----------------------------------------------------------------------------
# EMAIL PROVIDERS
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=                                        # Options: sendgrid, resend, ses, smtp (auto-detected if not set)
EMAIL_PROVIDER_URL=                                    # Optional - Custom email provider URL
EMAIL_PROVIDER_API_KEY=                                # Optional - For custom email provider
EMAIL_FROM_ADDRESS=noreply@yourdomain.com              # Required - Default from address
EMAIL_FROM=                                            # Optional - Alternative to EMAIL_FROM_ADDRESS
EMAIL_REPLY_TO=                                        # Optional - Default reply-to address
EMAIL_UNSUB_SECRET=                                    # Required - Secret for unsubscribe links

# SendGrid (Optional)
SENDGRID_API_KEY=                                      # Required if using SendGrid

# Resend (Optional)
RESEND_API_KEY=                                        # Required if using Resend

# SMTP (Optional)
SMTP_HOST=                                             # Required if using SMTP
SMTP_PORT=587                                          # Default: 587
SMTP_USER=
SMTP_PASS=

# Google Workspace SMTP (Optional)
GEMINI_SMTP_USER=                                      # For Google Workspace SMTP
GEMINI_SMTP_PASS=                                      # For Google Workspace SMTP

# Mail Provider (Optional - alternative email driver)
MAIL_PROVIDER_URL=                                     # Custom mail provider URL

# -----------------------------------------------------------------------------
# AI PROVIDERS
# -----------------------------------------------------------------------------
# Options: 'ollama' (FREE), 'bedrock' (AWS), 'anthropic' (paid API)
#
# COST COMPARISON:
#   ollama   = $0 (runs locally, requires ~8GB RAM)
#   bedrock  = Uses AWS credits (if you have them)
#   anthropic = ~$0.003/1K input, $0.015/1K output tokens
AI_PROVIDER=ollama                                     # Default: ollama

# Ollama (FREE - local/self-hosted)
# Install: https://ollama.ai/download
# Pull model: ollama pull qwen2.5:7b
# Start: ollama serve
OLLAMA_BASE_URL=http://localhost:11434                 # Default: http://localhost:11434
OLLAMA_HOST=                                           # Optional - Alternative to OLLAMA_BASE_URL
OLLAMA_MODEL=qwen2.5:7b                                # Default: qwen2.5:7b
OLLAMA_API_KEY=                                        # Optional - For authenticated Ollama

# AWS Bedrock (Production)
BEDROCK_MODEL_ID=                                      # Optional - Default Bedrock model
BEDROCK_MODEL_NEGOTIATE=us.anthropic.claude-3-haiku-20240307-v1:0   # For negotiation tasks
BEDROCK_MODEL_CLASSIFY=us.anthropic.claude-3-haiku-20240307-v1:0    # For classification tasks
BEDROCK_MONTHLY_CEILING_USD=50                         # Optional - Monthly spend cap

# Anthropic Direct (Alternative)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5                        # Default: claude-sonnet-5

# -----------------------------------------------------------------------------
# E-SIGNATURE PROVIDERS
# -----------------------------------------------------------------------------
ESIGN_PROVIDER=                                        # Options: docusign, documenso, hellosign, mock
ESIGN_WEBHOOK_SECRET=                                  # Required for e-sign webhooks

# DocuSign (Optional)
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_WEBHOOK_SECRET=

# Documenso (Optional)
DOCUMENSO_WEBHOOK_SECRET=

# HelloSign (Optional)
HELLOSIGN_API_KEY=

# -----------------------------------------------------------------------------
# PROPERTY DATA PROVIDERS (Optional)
# -----------------------------------------------------------------------------
PROPSTREAM_API_KEY=                                    # PropStream API
ATTOM_API_KEY=                                         # ATTOM Data API
RAPIDAPI_KEY=                                          # RapidAPI (various data sources)

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development                                   # Options: development, production, test
NEXT_PUBLIC_APP_URL=http://localhost:3000              # Required - Public app URL
NEXTAUTH_URL=                                          # Optional - NextAuth URL (alternative to BETTER_AUTH_URL)
PUBLIC_BASE_URL=                                       # Optional - Public base URL for webhooks
PUBLIC_WEBHOOK_URL=                                    # Optional - Public webhook URL for SMS/payment callbacks

# App Version (Optional)
APP_VERSION=                                           # Displayed in health checks

# Worker Configuration (Optional)
WORKER_MODE=                                           # Worker mode flag
VERCEL=                                                # Set automatically by Vercel deployment
JOB_POLL_INTERVAL_MS=3000                              # Job polling interval in ms

# -----------------------------------------------------------------------------
# LEGAL & COMPLIANCE (Required for Production)
# -----------------------------------------------------------------------------
LEGAL_ENTITY_NAME=Your Company LLC                     # Required for legal documents
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Your Company LLC         # Public version of legal entity name
LEGAL_ENTITY_STATE=Delaware                            # Required - State of incorporation
LEGAL_PHYSICAL_ADDRESS=                                # Required for CAN-SPAM compliance

# Company Info
COMPANY_ADDRESS=123 Main St, City, ST 12345            # Required for contracts
COMPANY_POSTAL_ADDRESS=123 Main St, City, ST 12345     # Required for email footers
POSTAL_ADDRESS=                                        # Optional - Alternative postal address
COMPANY_CONTACT_NAME=                                  # Optional - Contact name for contracts
COMPANY_PHONE=                                         # Optional - Company phone number
COMPANY_EMAIL=                                         # Optional - Company email

# Support
SUPPORT_EMAIL=support@yourdomain.com                   # Required - Support email
SUPPORT_PHONE=                                         # Optional - Support phone number

# Public Compliance (Optional)
NEXT_PUBLIC_COMPANY_ADDRESS=                           # Public version of company address

# -----------------------------------------------------------------------------
# ADMIN ALERTS (Optional)
# -----------------------------------------------------------------------------
ADMIN_ALERT_EMAIL=                                     # Admin notification email
ADMIN_ALERT_PHONE=                                     # Admin notification phone
ADMIN_ALERT_NAME=                                      # Admin contact name

# Owner Info (Optional)
OWNER_EMAIL=                                           # Owner email for notifications
OWNER_TIMEZONE=America/New_York                        # Default: America/New_York

# -----------------------------------------------------------------------------
# SECURITY & ENCRYPTION
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=                                        # Required for field-level encryption
OUTREACH_ENCRYPTION_KEY=                               # Optional - Defaults to BETTER_AUTH_SECRET

# -----------------------------------------------------------------------------
# CRON & BACKGROUND JOBS (Required for Production)
# -----------------------------------------------------------------------------
CRON_SECRET=                                           # Required for cron job authentication
JOB_RUNNER_SECRET=                                     # Required for job runner authentication

# -----------------------------------------------------------------------------
# WEBHOOKS (Optional)
# -----------------------------------------------------------------------------
CONTACT_NOTIFY_WEBHOOK_URL=                            # Webhook for contact form submissions

# -----------------------------------------------------------------------------
# FEATURE FLAGS & OVERRIDES (Optional)
# -----------------------------------------------------------------------------
DISPATCH_SKIP_QUIET_HOURS=false                        # Default: false - Skip quiet hours enforcement (CI/test ONLY)

# Assignment Fee
ASSIGNMENT_FEE_CENTS=1000000                           # Default: 1000000 ($10,000) - wholesale fee for margin estimates

# -----------------------------------------------------------------------------
# TESTING & DEVELOPMENT (Optional)
# -----------------------------------------------------------------------------
RUN_LIVE_FLOWS=false                                   # Default: false - Enable live integration tests
RUN_DEMO_HEADLINE=false                                # Default: false - Enable demo headline tests
DEMO_VERIFIED_TO=                                      # Verified phone for demos
TEST_DATABASE_URL=                                     # Separate database for tests

# -----------------------------------------------------------------------------
# MOBILE APP / EXPO (Optional)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_PROXY_BASE_URL=                            # Expo proxy URL
NEXT_PUBLIC_CREATE_HOST=                               # Create host URL
NEXT_PUBLIC_CREATE_ENV=                                # Create environment
NEXT_PUBLIC_CREATE_AUTH_PROVIDERS=                     # Enabled auth providers (comma-separated)

# -----------------------------------------------------------------------------
# UPLOADS (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_CREATE_USER_CONTENT_URL=              # User content upload URL

# -----------------------------------------------------------------------------
# SENTRY ERROR MONITORING (Optional)
# -----------------------------------------------------------------------------
# Installation:
#   npm install @sentry/nextjs
#   npx @sentry/wizard@latest -i nextjs
#
SENTRY_DSN=                                            # Sentry DSN (enables error monitoring)
NEXT_PUBLIC_SENTRY_DSN=                                # Client-side Sentry DSN (same as SENTRY_DSN)
SENTRY_ENVIRONMENT=                                    # Optional - Environment name (defaults to NODE_ENV)
SENTRY_RELEASE=                                        # Optional - Release version (auto-detected)
SENTRY_AUTH_TOKEN=                                     # Optional - For source maps upload in CI/CD
SENTRY_ORG=                                            # Optional - Sentry organization slug
SENTRY_PROJECT=                                        # Optional - Sentry project slug
